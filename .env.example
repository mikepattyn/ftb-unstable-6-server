# First read https://www.minecraft.net/en-us/eula and change FALSE to TRUE if you agree.
EULA=FALSE

# FTB Unstable 6 pack 1.11.0; this is the FTB version ID, not Minecraft's version.
FTB_MODPACK_VERSION_ID=100507

# Java heap size. Allow additional RAM for the OS and other server processes.
MEMORY=8G
MC_PORT=25565

# Replace with your Minecraft Java Edition profile name (not an Xbox gamertag).
WHITELIST=YourJavaProfileName
OPS=YourJavaProfileName
